# LiveStore / OpenCart MCP Server Configuration
# Copy this to .env and fill in your values.

# ──────────────────────────────────────────────────────────────────
# DIRECT MYSQL (no SSH)
# Use when the host allows remote MySQL (or you have a tunnel).
# Leave OPENCART_SSH_HOST empty. File/cache tools will refuse until
# SSH or DDEV is configured — they will not touch a local copy of
# the store thinking it is production.
# ──────────────────────────────────────────────────────────────────

OPENCART_SSH_HOST=
OPENCART_DB_HOST=your-mysql-host
OPENCART_DB_PORT=3306
OPENCART_DB_USER=your_db_user
OPENCART_DB_PASS=your_db_password
OPENCART_DB_NAME=your_opencart_database
OPENCART_DB_PREFIX=oc_
OPENCART_ROOT=/path/to/opencart
OPENCART_STORAGE=/path/to/storage
# OPENCART_LANGUAGE_ID=1

# ──────────────────────────────────────────────────────────────────
# REMOTE VPS (SSH + PHP stdin)
# Preferred when SSH is available — DB credentials stay on the server.
# Set OPENCART_SSH_HOST and you can omit OPENCART_DB_HOST (read from
# config.php).
# ──────────────────────────────────────────────────────────────────

# OPENCART_SSH_HOST=your-server-ip
# OPENCART_SSH_USER=your-ssh-username
# OPENCART_SSH_KEY=~/.ssh/id_ed25519
# OPENCART_SSH_PORT=22
# OPENCART_DB_USER=your_db_user
# OPENCART_DB_PASS=your_db_password
# OPENCART_DB_NAME=your_opencart_database
# OPENCART_ROOT=/path/to/opencart
# OPENCART_STORAGE=/path/to/storage

# ──────────────────────────────────────────────────────────────────
# LOCAL DDEV
# SSH_HOST=ddev triggers DDEV mode. Container paths are auto-set to
# /var/www/html — you only set the LOCAL project path.
# ──────────────────────────────────────────────────────────────────

# OPENCART_SSH_HOST=ddev
# OPENCART_DB_USER=db
# OPENCART_DB_PASS=db
# OPENCART_DB_NAME=db
# OPENCART_ROOT=/Users/you/Sites/your-opencart-project
